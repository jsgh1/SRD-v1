                                  "integer",
                                  "null"
                                ]
                              },
                              "height": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "items"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "correlation_id": {
                          "type": "string",
