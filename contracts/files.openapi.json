          },
          "404": {
            "description": "Recurso no disponible"
          },
          "409": {
            "description": "Versión en conflicto"
          },
          "413": {
            "description": "Solicitud mayor de 7 MiB"
          },
          "422": {
            "description": "Datos o imagen inválidos"
          },
          "503": {
