{
  "openapi": "3.1.0",
  "info": {
    "title": "SRD Archivos: API interna de fotografías",
    "version": "0.1.0",
    "description": "Servicio incorporado a Compose y conectado a rutas autenticadas del gateway. Solo emisor gateway con contexto de sesión previamente validada. El servicio consulta a Registros o Inventario y exige antivirus real y comprobación reciente de firmas. Este contrato describe su API interna. Las rutas de bienes verifican la junta y el estado activo en Inventario; la lectura se conserva tras la baja. La ruta photo-deletions admite exclusivamente al emisor records para órdenes persistentes de limpieza."
  },
  "servers": [
    {
      "url": "http://files:8000/internal/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "internal": {
        "type": "apiKey",
        "in": "header",
        "name": "X-SRD-Context",
        "description": "Contexto HMAC ligado a audiencia files, cuerpo, método, ruta, nonce y caducidad; incluye junta, usuario, rol y session_id."
      }
    }
  },
